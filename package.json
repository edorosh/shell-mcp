{
  "name": "@edorosh/shell-mcp",
  "version": "1.0.2",
  "description": "MCP server running shell commands inside a microsandbox",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/edorosh/shell-mcp.git"
  },
  "homepage": "https://github.com/edorosh/shell-mcp#readme",
  "bugs": "https://github.com/edorosh/shell-mcp/issues",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "sandbox",
    "microsandbox",
    "shell",
    "windows",
    "macos"
  ],
  "scripts": {
