    "check:pack": "node scripts/check-pack.mjs",
    "prepack": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "microsandbox": "0.7.11",
    "zod": "^4.6.7"
